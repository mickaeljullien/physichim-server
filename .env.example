# Copier ce fichier en .env pour le développement local (jamais commité).
# En production (Railway), ces variables sont définies directement dans les réglages
# du service — ce fichier n'est utilisé qu'en local.

# Base élèves (PostgreSQL, service séparé) — obligatoire.
STUDENT_DATABASE_URL=postgres://postgres:postgres@localhost:5432/physichim_eleves

# Base appli (SQLite) — optionnel, par défaut ./physichim.db
# DB_PATH=./physichim.db

# Clé maître admin — optionnel en local (générée automatiquement sinon), obligatoire en production
# ADMIN_KEY=

# Port du serveur — optionnel, par défaut 3000
# PORT=3000
